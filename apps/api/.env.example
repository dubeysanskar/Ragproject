# GoaRAG — copy to .env and fill in. Everything runs with NO keys at all:
# STT falls back to browser typing, generation falls back to extractive-only.

# ---- corpus ----
# Path to the corpus built by scripts/build_corpus.py. Missing file = tiny
# built-in demo corpus, so a clean clone still boots.
GOARAG_CORPUS=data/corpus.json

# ---- speech-to-text (task constraint: Sarvam OR ElevenLabs — pick one) ----
# Primary: Sarvam (Indic ASR, streaming).
SARVAM_API_KEY=
# Fallback adapter (same interface, used only if Sarvam fails/absent):
ELEVENLABS_API_KEY=

# ---- generative escalation path (no provider constraint; free-first) ----
# Tried in order; first configured key wins. All optional.
GROQ_API_KEY=
GEMINI_API_KEY=
# Model used with the Gemini adapter (user preference: 2.5 flash family).
GEMINI_MODEL=gemini-2.5-flash
